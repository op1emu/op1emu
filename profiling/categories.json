{
  "comment": "Host-path buckets for `op1prof report`. Each execution sample goes to the bucket of the frame nearest its leaf that matches any rule; within one frame the first rule in this list wins. A pattern matches where it starts a name in the demangled symbol (so Bus:: does not match DMABus::). Samples whose stack reaches no root have a broken call chain and are counted apart. RegisterDevice:: (a device's register map) is deliberately no rule: a device reading its own registers is that device's time, and a guest access to them is a memory callback through the frames above it.",
  "roots": ["BlackFinCpu::Run(", "BootExcutionThread(", "LdrExecutionThread("],
  "categories": [
    {"name": "profiler",         "match": ["Profiler::", "FrameTap::"]},
    {"name": "logging",          "match": ["LogImpl(", "LogDebug(", "LogInfo(", "LogWarn(", "LogError(", "spdlog::"]},
    {"name": "nand",             "match": ["NFC::", "NandFlash::", "MT29F4G08::"]},
    {"name": "sport/audio",      "match": ["SPORT::", "AudioOutput"]},
    {"name": "ppi/display",      "match": ["PPI::", "Display::", "OLED::"]},
    {"name": "dma",              "match": ["DMAChannel::", "DMABus::", "DMA::"]},
    {"name": "rtc",              "match": ["RTC::"]},
    {"name": "usb",              "match": ["USBDevice::", "USB::"]},
    {"name": "timers",           "match": ["CoreTimer::", "GPTimer", "PanelOscillator::"]},
    {"name": "interrupts",       "match": ["SIC::", "cec_", "BlackFinCpu::ProcessInterrupt("]},
    {"name": "gpio/twi/sensors", "match": ["GPIO", "TWI::", "I2CPeripheral", "RegisterI2CPeripheral", "DummyI2CPeripheral", "MCP230XX::", "ADXL345::", "Potentiometer::", "Keyboard::"]},
    {"name": "event queue",      "match": ["BlackFinCpu::ProcessEvents(", "BlackFinCpu::QueueEvent("]},
    {"name": "memory callbacks", "match": ["mem_read", "mem_write", "Emulator::Memory", "EmulatorMemory::", "MemoryDevice::", "FastMem::", "EBIU::", "Bus::"]},
    {"name": "generated code",   "match": ["bb_0x", "bcore_cp_"]},
    {"name": "dispatch",         "match": ["Core::run(", "JitEngine::lookup("]},
    {"name": "cpu loop",         "match": ["BlackFinCpu::"]}
  ]
}
